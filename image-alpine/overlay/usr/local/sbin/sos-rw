#!/bin/sh
# Fenêtre d'écriture sur SOSDATA (montée ro le reste du temps).
# open : remonte rw + pose le marqueur ; close : retire le marqueur + remonte ro.
# Le marqueur signale au garde-fou (sos-ro-guard) qu'une écriture est légitime.
set -eu
MP=/var/lib/sosguide; MARK=/run/sos-rw.active
case "${1:-}" in
  open)  mount -o remount,rw "$MP"; date +%s > "$MARK" ;;
  close) rm -f "$MARK"; sync; mount -o remount,ro "$MP" ;;
  *) echo "usage: sos-rw open|close" >&2; exit 2 ;;
esac
