#!/bin/sh
# Sélectionne le binaire applicatif au boot (modèle A/B diskless), AVANT le
# démarrage du service. Anti-bricage : le binaire d'usine reste cuit dans
# l'apkovl (/usr/local/bin/sos-guide) ; le slot FAT n'est qu'une surcouche OTA.
#
#   1. MAJ marquée « failed » (échec santé au boot précédent) → rollback du slot
#      vers .prev, puis on repart sur l'usine si besoin.
#   2. Slot OTA présent + signature/empreinte valides + version >= usine →
#      on l'installe sur /usr/local/bin/sos-guide.
#   3. Sinon → on garde l'usine (toujours un binaire fonctionnel).
set -u

SLOT=$(awk '$3=="vfat"{print $2; exit}' /proc/mounts); SLOT="${SLOT:-/media/mmcblk0p1}"
BIN="$SLOT/sos-guide.bin";          MAN="$SLOT/manifest.json"
PREVBIN="$SLOT/sos-guide.bin.prev"; PREVMAN="$SLOT/manifest.json.prev"
PENDING="$SLOT/update.pending";     FAILED="$SLOT/update.failed"
PUB=/etc/sosguide/release.pub
FAC_MAN=/etc/sosguide/manifest.json
DST=/usr/local/bin/sos-guide

verify() { sos-cli verify-update "$2" "$1" "$PUB" >/dev/null 2>&1; }
ver()    { sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$1" 2>/dev/null | head -n1; }
# $1 >= $2 ? (comparaison numérique segment par segment, repli sur 0)
vge() {
    awk -v a="$1" -v b="$2" 'BEGIN{
        na=split(a,A,/[.+-]/); nb=split(b,B,/[.+-]/); n=(na>nb?na:nb);
        for(i=1;i<=n;i++){x=A[i]+0;y=B[i]+0; if(x>y){print 1;exit} if(x<y){print 0;exit}}
        print 1
    }'
}

# (1) Rollback d'une MAJ en échec : restaure le slot précédent.
if [ -f "$FAILED" ]; then
    if mount -o remount,rw "$SLOT" 2>/dev/null; then
        if [ -f "$PREVBIN" ]; then
            cp "$PREVBIN" "$BIN"
            [ -f "$PREVMAN" ] && cp "$PREVMAN" "$MAN"
        else
            rm -f "$BIN" "$MAN"   # pas de précédent → retour pur à l'usine
        fi
        rm -f "$FAILED" "$PENDING"
        sync; mount -o remount,ro "$SLOT" 2>/dev/null || true
    fi
fi

# (2) Slot OTA valide + version >= usine ⇒ on l'installe par-dessus l'usine.
if [ -f "$BIN" ] && [ -f "$MAN" ] && verify "$BIN" "$MAN"; then
    sv=$(ver "$MAN"); fv=$(ver "$FAC_MAN")
    if [ -n "$sv" ] && { [ -z "$fv" ] || [ "$(vge "$sv" "$fv")" = 1 ]; }; then
        if cp "$BIN" "$DST.new" 2>/dev/null; then
            chmod 755 "$DST.new"; mv "$DST.new" "$DST"
        fi
    fi
fi

# (3) Sinon : binaire d'usine conservé. Toujours sortir 0 (ne bloque pas le boot).
exit 0
