#!/bin/sh
# Garde-fou périodique (crond) : si SOSDATA est montée rw sans fenêtre d'écriture
# légitime en cours, la re-verrouille en ro. Couvre le cas résiduel d'un SIGKILL
# du nœud pendant un instantané Redb ou une écriture de tuiles.
MP=/var/lib/sosguide
MARK=/run/sos-rw.active   # posé par sos-rw/sos-commit-db pendant leur fenêtre
TTL=300                   # plafond d'exposition rw d'un marqueur orphelin (s)

# SOSDATA est-elle montée rw ? (sinon rien à faire)
awk -v mp="$MP" '$2==mp && $4 ~ /(^|,)rw(,|$)/{f=1} END{exit !f}' /proc/mounts || exit 0

# Fenêtre légitime et récente en cours ? → ne pas intervenir.
if [ -f "$MARK" ]; then
    ts=$(cat "$MARK" 2>/dev/null || echo 0)
    [ "$(( $(date +%s) - ts ))" -lt "$TTL" ] && exit 0
fi

# rw orpheline → re-verrouille proprement.
sync
if mount -o remount,ro "$MP" 2>/dev/null; then
    logger -t sos-ro-guard "SOSDATA re-verrouillee en ro (rw orpheline detectee)"
fi
rm -f "$MARK"
