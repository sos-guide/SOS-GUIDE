#!/bin/sh
# Confirme (ou infirme) une MAJ « pending » APRÈS le boot, via la santé du
# portail. Lancé en arrière-plan par le service sosguide (start_post).
#
#   - portail sain (/api/status) dans le délai → efface le marqueur pending :
#     la MAJ est confirmée, .prev devient le filet de secours.
#   - jamais sain → pose update.failed et reboote : sos-boot-select fera le
#     rollback A/B au prochain démarrage.
set -u

SLOT=$(awk '$3=="vfat"{print $2; exit}' /proc/mounts); SLOT="${SLOT:-/media/mmcblk0p1}"
PENDING="$SLOT/update.pending"; FAILED="$SLOT/update.failed"

[ -f "$PENDING" ] || exit 0   # aucune MAJ à confirmer : rien à faire

# Sonde santé locale : jusqu'à ~90 s (30 × 3 s), le temps que le portail monte.
ok=0; i=0
while [ "$i" -lt 30 ]; do
    if curl -fsS --max-time 3 http://127.0.0.1/api/status >/dev/null 2>&1; then ok=1; break; fi
    i=$((i + 1)); sleep 3
done

mount -o remount,rw "$SLOT" 2>/dev/null || true
if [ "$ok" = 1 ]; then
    rm -f "$PENDING" "$FAILED"            # MAJ confirmée
    sync; mount -o remount,ro "$SLOT" 2>/dev/null || true
    echo "sos-update-confirm: MAJ confirmée (portail sain)"
    exit 0
fi
date +%s > "$FAILED"                       # échec santé → rollback au prochain boot
sync; mount -o remount,ro "$SLOT" 2>/dev/null || true
echo "sos-update-confirm: portail non sain — rollback et reboot" >&2
reboot
