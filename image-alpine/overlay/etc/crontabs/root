# Maintenance périodique (Alpine standard)
*/15	*	*	*	*	run-parts /etc/periodic/15min
0	*	*	*	*	run-parts /etc/periodic/hourly
0	2	*	*	*	run-parts /etc/periodic/daily
0	3	*	*	6	run-parts /etc/periodic/weekly
0	5	1	*	*	run-parts /etc/periodic/monthly
# SOSGUIDE — garde-fou ro SOSDATA (re-verrouille une rw orpheline)
*	*	*	*	*	/usr/local/sbin/sos-ro-guard
# SOSGUIDE — vérification de mise à jour OTA (pull signé) toutes les 30 min ;
# no-op si update.conf désactivé/absent (ENABLED=0). Anti-downgrade + rollback.
*/30	*	*	*	*	/usr/local/sbin/sos-update
