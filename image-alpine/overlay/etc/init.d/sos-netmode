#!/sbin/openrc-run
# Réseau SOS-GUIDE — modèle décidé : wlan0 = AP TOUJOURS actif (OUVERT),
# eth0 = uplink OPTIONNEL. Monte l'AP avec hostapd (radio) + dnsmasq (DHCP + DNS
# portail captif), et — si un câble Ethernet est présent — prend une IP DHCP sur
# eth0 + publie « sosguide.local » (mDNS/avahi). L'appli (SOS_NET_MODE=off) sert
# le portail sur :80 ; ce service ne gère QUE la couche réseau.
#
# Garanties : AP **ouvert** (aucun obstacle citoyen) ; **aucun surf Internet**
# (eth0 jamais routé vers les clients : ip_forward=0 + FORWARD DROP) ; isolation
# client-à-client (hostapd ap_isolate) ; aucun bail DHCP persisté (nLPD).
name="sos-netmode"
description="AP WiFi ouvert (hostapd+dnsmasq) + uplink Ethernet optionnel"

depend() {
    need localmount
    after modloop modules
    before sosguide
}

# Écrit stdin dans <nom> sur la partition FAT (diagnostic de boot, best-effort).
write_boot() {
    local name="$1" tmp=/tmp/diag.$$
    cat > "$tmp"
    local fat; fat=$(awk '$3=="vfat"{print $2; exit}' /proc/mounts)
    if [ -n "$fat" ]; then
        mount -o remount,rw "$fat" 2>/dev/null
        cp "$tmp" "$fat/$name" 2>/dev/null
        sync; mount -o remount,ro "$fat" 2>/dev/null
    fi
    rm -f "$tmp"
}

start() {
    local LOG=/var/log/sos-netmode.log
    : > "$LOG"
    echo "sos-netmode $(date) — $(uname -r)" | write_boot BOOT_OK.txt
    {
        echo "=== sos-netmode $(date) ==="

        # 1) Paquets AP installés hors-ligne depuis la FAT.
        echo "## apk add (paquets AP hors-ligne)"
        apk add --no-network --allow-untrusted --force-non-repository /media/mmcblk0p1/extra/*.apk 2>&1

        # 2) Conf AP éditable sur SOSBOOT/ap.conf (SSID / COUNTRY / CHANNEL).
        AP_SSID="SOS-GUIDE"; AP_COUNTRY="FR"; AP_CHANNEL="6"
        CONF=/media/mmcblk0p1/ap.conf
        if [ -f "$CONF" ]; then
            while IFS= read -r line || [ -n "$line" ]; do
                line=$(printf '%s' "$line" | tr -d '\015')
                case "$line" in ''|\#*) continue ;; esac
                k=$(printf '%s' "${line%%=*}" | tr -d '[:space:]'); v=${line#*=}
                case "$k" in
                    SSID)    [ -n "$v" ] && AP_SSID=$v ;;
                    COUNTRY) [ -n "$v" ] && AP_COUNTRY=$v ;;
                    CHANNEL) [ -n "$v" ] && AP_CHANNEL=$v ;;
                esac
            done < "$CONF"
        fi
        echo "ap.conf : SSID='$AP_SSID' COUNTRY='$AP_COUNTRY' CHANNEL='$AP_CHANNEL'"

        # 3) Module WiFi + attente de wlan0.
        echo "## modprobe brcmfmac + attente wlan0"
        i=0; while [ ! -d "/lib/modules/$(uname -r)" ] && [ "$i" -lt 40 ]; do sleep 0.5; i=$((i+1)); done
        modprobe brcmfmac 2>&1
        i=0; while [ ! -e /sys/class/net/wlan0 ] && [ "$i" -lt 60 ]; do sleep 0.5; i=$((i+1)); done

        if [ ! -e /sys/class/net/wlan0 ]; then
            echo "## ECHEC: wlan0 absente — pas d'AP"
        else
            # 4) AP OUVERT : adresse statique + hostapd + dnsmasq.
            echo "## wlan0 → AP OUVERT 10.0.0.1/24 (canal $AP_CHANNEL, $AP_COUNTRY)"
            ip addr flush dev wlan0 2>/dev/null
            ip addr add 10.0.0.1/24 dev wlan0 2>&1
            ip link set wlan0 up 2>&1

            HOSTAPD=/tmp/hostapd.conf
            {
                echo "interface=wlan0"
                echo "driver=nl80211"
                echo "ssid=$AP_SSID"
                echo "country_code=$AP_COUNTRY"
                echo "ieee80211d=1"
                echo "hw_mode=g"
                echo "channel=$AP_CHANNEL"
                echo "auth_algs=1"
                echo "wmm_enabled=1"
                echo "ap_isolate=1"            # pas de client-à-client (kiosque public)
                echo "ignore_broadcast_ssid=0" # OUVERT, SSID visible, aucune clé
            } > "$HOSTAPD"
            hostapd -B "$HOSTAPD" 2>&1
            sleep 2

            DNSMASQ=/tmp/dnsmasq.conf
            {
                echo "interface=wlan0"
                echo "bind-interfaces"          # ne touche QUE wlan0 (le nœud résout via eth0)
                echo "no-resolv"
                echo "no-hosts"
                echo "dhcp-range=10.0.0.10,10.0.0.250,255.255.255.0,12h"
                echo "dhcp-option=3,10.0.0.1"   # passerelle = nœud
                echo "dhcp-option=6,10.0.0.1"   # DNS = nœud
                echo "address=/#/10.0.0.1"      # capture DNS totale → portail captif
                echo "dhcp-authoritative"
                echo "leasefile-ro"             # aucun bail persisté (nLPD)
            } > "$DNSMASQ"
            dnsmasq -C "$DNSMASQ" 2>&1

            # 5) AUCUN surf : pas de routage AP↔Ethernet.
            echo 0 > /proc/sys/net/ipv4/ip_forward 2>/dev/null
            iptables -P FORWARD DROP 2>/dev/null
            echo "## AP '$AP_SSID' OUVERT actif — 10.0.0.1, DHCP + portail captif"
        fi

        # 6) Uplink Ethernet OPTIONNEL : lien présent → DHCP + mDNS sosguide.local.
        echo "## eth0 (uplink optionnel)"
        if [ -e /sys/class/net/eth0 ]; then
            ip link set eth0 up 2>/dev/null
            sleep 2
            if [ "$(cat /sys/class/net/eth0/carrier 2>/dev/null)" = "1" ]; then
                echo "eth0 : lien présent → DHCP + mDNS"
                udhcpc -i eth0 -s /usr/local/sbin/sos-udhcpc.script -t 10 -T 2 -b 2>&1
                avahi-daemon -D 2>&1 || echo "avahi indisponible (mDNS désactivé, accès par IP)"
            else
                echo "eth0 : pas de lien → mode AP autonome"
            fi
        else
            echo "eth0 absente → mode AP autonome"
        fi
    } >> "$LOG" 2>&1

    # Diagnostic complet sur la FAT (debug du 1er flash).
    {
        echo "===== SOS-GUIDE NETMODE DIAG $(date) ====="
        echo "## interfaces"; ip -o addr 2>&1
        echo "## hostapd"; pgrep -a hostapd 2>&1 || echo "(hostapd absent)"
        echo "## dnsmasq"; pgrep -a dnsmasq 2>&1 || echo "(dnsmasq absent)"
        echo "## avahi"; pgrep -a avahi-daemon 2>&1 || echo "(avahi absent)"
        echo "## paquets AP"; apk info -e hostapd dnsmasq iptables avahi 2>&1
        echo "## log"; cat "$LOG" 2>&1
    } | write_boot DIAG.txt

    # Diagnostic DIFFÉRÉ du portail : le service « sosguide » démarre APRÈS nous
    # (before sosguide) ; on capture son état ~25 s plus tard sur la FAT, pour
    # diagnostiquer un portail injoignable sans écran ni SSH (debug 1er flash).
    (
        sleep 25
        {
            echo "===== SOSGUIDE DIAG $(date) ====="
            echo "## processus"
            if pidof sos-guide >/dev/null 2>&1; then
                echo "sos-guide EN COURS (pid $(pidof sos-guide))"
            else
                echo "sos-guide ABSENT (planté ou non démarré)"
            fi
            echo "## rc-service status"; rc-service sosguide status 2>&1
            echo "## écoute sur :80 ?"; netstat -tln 2>/dev/null | grep ':80 ' || echo "(rien n'écoute sur :80)"
            echo "## SOSDATA (p2) montée ?"; mount 2>&1 | grep mmcblk0p2 || echo "SOSDATA NON montée"
            echo "## /var/lib/sosguide"; ls -la /var/lib/sosguide/ 2>&1
            echo "## log portail (tail 60)"; tail -n 60 /var/log/sosguide.log 2>&1 || echo "(aucun log)"
        } | write_boot SOSGUIDE_DIAG.txt
    ) &
    return 0
}

stop() {
    pkill dnsmasq 2>/dev/null
    pkill hostapd 2>/dev/null
    pkill avahi-daemon 2>/dev/null
    pkill udhcpc 2>/dev/null
    return 0
}
