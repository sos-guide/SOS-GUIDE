#!/sbin/openrc-run
name="sosguide"
description="SOS-GUIDE — portail d'urgence hors-ligne"
command="/usr/local/bin/sos-guide"
command_background=true
pidfile="/run/sosguide.pid"
output_log="/var/log/sosguide.log"
error_log="/var/log/sosguide.log"
respawn_delay=2

depend() {
    need localmount
    after net
}

start_pre() {
    # base de travail Redb en RAM (tmpfs) ; SOSDATA reste en lecture seule
    mkdir -p /run/sosguide /var/log
    # Sélection A/B : installe le binaire OTA du slot FAT s'il est vérifié et
    # plus récent que l'usine, sinon garde l'usine (anti-bricage). Best-effort.
    [ -x /usr/local/sbin/sos-boot-select ] && /usr/local/sbin/sos-boot-select || true
}

start_post() {
    # Confirme une éventuelle MAJ « pending » via la santé du portail (rollback
    # automatique en cas d'échec). Détaché pour ne pas retarder le boot.
    if [ -x /usr/local/sbin/sos-update-confirm ]; then
        /usr/local/sbin/sos-update-confirm >> /var/log/sos-update.log 2>&1 &
    fi
    return 0
}
